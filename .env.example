# ===== 镜像来源 =====
# 海外服务器（默认）：GHCR 官方镜像
OPENCODE2API_IMAGE=ghcr.io/jasonxu114514/opencode2api
# 国内服务器（ghcr.io 拉取慢）：先执行 docker build -t opencode2api:local .
# 再把上面一行改成：OPENCODE2API_IMAGE=opencode2api

# ===== 版本 =====
# 建议固定具体版本（如 v1.0.0），去 GitHub Releases 查看最新 tag
OPENCODE2API_VERSION=latest

# ===== 监听地址（一般不用改，留空则用 config.json 里的地址）=====
# OPENCODE2API_LISTEN=
# OPENCODE2API_WEBUI_LISTEN=
